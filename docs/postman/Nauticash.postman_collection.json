    {
      "name": "2 · Portefeuille",
      "item": [
        {
          "name": "Portefeuille (contrôle des cours)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/user/portfolio",
            "description": "Affiche dans la console Postman un tableau ticker / prix / veille / date du cours / source / erreur, et vérifie que chaque cours est daté et actualisé."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const { stocks = [] } = pm.response.json();",
                  "const now = Date.now();",
                  "const rows = stocks.map((s) => ({",
                  "  ticker: s.ticker, prix: s.close, devise: s.currency, veille: s.previousClose, jour: s.dayChangePercent,",
                  "  coteLe: s.priceTime, ageMin: s.priceTime ? Math.round((now - new Date(s.priceTime)) / 60000) : null,",
                  "  place: s.exchange, zone: s.zone, indice: s.exposure, source: s.source, erreur: s.priceError,",
                  "}));",
                  "console.log(JSON.stringify(rows, null, 2));",
                  "const tpl = `<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px}th{background:#eee}.ko{background:#fdd}</style><table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr class=\"{{#if bad}}ko{{/if}}\">{{#each cells}}<td>{{this}}</td>{{/each}}</tr>{{/each}}</table>`;",
                  "const cols = [\"Ticker\", \"Prix\", \"Devise\", \"Veille\", \"Jour %\", \"Coté le\", \"Âge (min)\", \"Place\", \"Zone\", \"Indice\", \"Source\", \"Erreur\"];",
                  "pm.visualizer.set(tpl, { cols, rows: rows.map((r) => ({ bad: !r.coteLe || r.erreur || r.veille == null, cells: [r.ticker, r.prix, r.devise, r.veille, r.jour != null ? r.jour.toFixed(2) : \"—\", r.coteLe ? new Date(r.coteLe).toLocaleString(\"fr-FR\") : \"NON DATÉ\", r.ageMin, r.place, r.zone, r.indice || \"\", r.source, r.erreur || \"\"] })) });",
                  "pm.test(\"Tous les titres ont un cours > 0\", () => pm.expect(stocks.filter((s) => !(s.close > 0)).map((s) => s.ticker)).to.eql([]));",
                  "pm.test(\"Tous les cours sont datés\", () => pm.expect(stocks.filter((s) => !s.priceTime).map((s) => s.ticker)).to.eql([]));",
                  "pm.test(\"Aucune actualisation en échec\", () => pm.expect(stocks.filter((s) => s.priceError).map((s) => `${s.ticker}: ${s.priceError}`)).to.eql([]));",
                  "pm.test(\"Variation du jour connue (veille renseignée)\", () => pm.expect(stocks.filter((s) => s.type !== \"Crypto\" && s.previousClose == null).map((s) => s.ticker)).to.eql([]));"
                ]
              }
            }
          ]
        },

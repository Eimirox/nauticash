    {
      "name": "5 · Admin (ADMIN_EMAILS)",
      "item": [
        {
          "name": "Diagnostic d'un titre",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/diagnose/{{ticker}}",
            "description": "Compare le cours enregistré avec la réponse en direct de chaque fournisseur (FMP, Finnhub, Yahoo). Consomme 1 à 3 appels FMP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "console.log(\"Marché ouvert :\", d.marketOpen, \"| enregistré :\", d.stored);",
                  "const prov = Object.entries(d.providers).map(([p, r]) => ({ fournisseur: p, ok: r.ok, prix: r.price, veille: r.previousClose, devise: r.currency, ecartPct: r.diffWithStoredPct != null ? r.diffWithStoredPct.toFixed(2) : null, erreur: r.error || r.skipped || \"\" }));",
                  "console.log(JSON.stringify(prov, null, 2));",
                  "const tpl = `<style>table{border-collapse:collapse;font:13px sans-serif}td,th{border:1px solid #ccc;padding:4px 8px}th{background:#eee}.ko{background:#fdd}</style><table><tr>{{#each cols}}<th>{{this}}</th>{{/each}}</tr>{{#each rows}}<tr class=\"{{#if bad}}ko{{/if}}\">{{#each cells}}<td>{{this}}</td>{{/each}}</tr>{{/each}}</table>`;",
                  "pm.visualizer.set(tpl, { cols: [\"Fournisseur\", \"OK\", \"Prix\", \"Veille\", \"Devise\", \"Écart vs enregistré (%)\", \"Erreur\"], rows: prov.map((r) => ({ bad: !r.ok, cells: [r.fournisseur, r.ok ? \"oui\" : \"non\", r.prix, r.veille, r.devise, r.ecartPct, r.erreur] })) });",
                  "pm.test(\"Au moins un fournisseur répond\", () => pm.expect(Object.values(d.providers).some((r) => r.ok)).to.be.true);",
                  "pm.test(\"Écart avec le cours enregistré < 2 %\", () => { const ok = Object.values(d.providers).filter((r) => r.ok && r.diffWithStoredPct != null); pm.expect(ok.every((r) => Math.abs(r.diffWithStoredPct) < 2)).to.be.true; });"
                ]
              }
            }
          ]
        },

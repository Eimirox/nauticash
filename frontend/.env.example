# Variables d'environnement du frontend (à définir dans Vercel)

# URL du backend (Railway)
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Adresse qui reçoit les retours de la bêta (lien « Donner mon avis » masqué si vide)
NEXT_PUBLIC_CONTACT_EMAIL=

# Adresse publique du site pour le SEO (sitemap.xml, robots.txt, balises Open Graph).
# Facultatif sur Vercel : le domaine de production (VERCEL_PROJECT_PRODUCTION_URL) est utilisé par défaut.
NEXT_PUBLIC_SITE_URL=https://nauticash.example

# Bêta privée : protège tout le site par Basic Auth si les deux sont définis
# (robots.txt demande alors aux moteurs de ne rien indexer)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

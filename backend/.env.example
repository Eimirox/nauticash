# Copier ce fichier en .env et remplir les valeurs (ne jamais committer le .env)

# --- Obligatoire ---
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/nauticash
JWT_SECRET=une-longue-chaine-aleatoire-d-au-moins-32-caracteres
FRONTEND_URL=https://ton-site.vercel.app

# --- Administration (routes /api/admin) ---
ADMIN_EMAILS=ton-email@exemple.com

# --- Emails (mot de passe oublié) ---
RESEND_API_KEY=
EMAIL_FROM=Nauticash <no-reply@ton-domaine.fr>

# --- Données de marché ---
FMP_API_KEY=
ACTIVE_PROVIDERS=fmp
# ALPHA_VANTAGE_ENABLED=true
# ALPHA_VANTAGE_API_KEY=
# Quotas journaliers si tu passes sur une offre payante (par défaut : offre gratuite ; 0 = provider coupé)
# FMP_DAILY_LIMIT=250
# ALPHAVANTAGE_DAILY_LIMIT=25

# --- Optionnel ---
# Historique quotidien des portefeuilles (heure UTC ; CRON_DAILY_HISTORY=false pour désactiver)
# CRON_HISTORY_SCHEDULE=45 21 * * *
# CRON_DAILY_HISTORY=true
# Finnhub (optionnel) : secours pour les actions US hors offre FMP, essayé avant Yahoo.
# Désactivé tant que la clé est vide ; offre gratuite ~60 appels/min (plafond interne 55/min)
# FINNHUB_API_KEY=
# FINNHUB_ENABLED=true
# Yahoo Finance (secours sans clé pour les symboles hors offre FMP + recherche de tickers)
# YAHOO_ENABLED=true
# Cours en journée (Yahoo, marchés ouverts uniquement) : CRON_LIVE_PRICES=false pour désactiver
# LIVE_PRICES_SCHEDULE=* * * * *
# LIVE_MAX_PER_RUN=30
# LIVE_MIN_AGE_SECONDS=55
# Actualisation complète du soir (FMP + profil + dividendes), heure UTC
# CRON_UPDATE_SCHEDULE=15 21 * * *
# HEALTHCHECK_ON_START=false
